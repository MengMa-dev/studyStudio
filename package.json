{
  "name": "study-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:extension": "node scripts/build-extension.js",
    "ingestion": "tsx services/local-ingestion/src/server.js",
    "demo": "node scripts/demo-ingestion.js",
    "e2e:extension": "node scripts/e2e-extension.js",
    "browser:login": "node scripts/browser-login.js",
    "setup:ai": "node scripts/setup-dev-ai.js",
    "typecheck": "tsc -p . && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.js\" \"packages/*/test/**/*.test.ts\" \"services/*/test/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "verify:sqlite": "tsx scripts/verify/sqlite.ts",
    "verify:ai": "tsx scripts/verify/ai-structured-output.ts",
    "verify:wxt": "tsx scripts/verify/wxt-extension.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "workspaces": [
    "apps/workbench",
    "apps/browser-extension",
    "packages/shared",
    "packages/collector-contract",
    "packages/collector-runtime",
    "services/local-ingestion"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
